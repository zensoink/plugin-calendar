{
  "name": "zenso-plugin-example",
  "description": "Example plugin and starter for Zenso e-ink displays",
  "version": "0.0.2",
  "author": "zenso",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "prebuild": "rm -rf ./dist/*",
    "build": "vite build && vite build --config vite.calendar.config.js",
    "postbuild": "npm run zip:pack",
    "zip:pack": "cd dist && zip -r plugin.zip .",
    "mock:refresh": "node scripts/refresh-mock.mjs"
  },
  "homepage": "https://github.com/zensoink/zenso-plugin-examples#readme",
  "bugs": {
    "url": "https://github.com/zensoink/zenso-plugin-examples/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zensoink/zenso-plugin-examples.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@vituum/vite-plugin-liquid": "^2",
    "node-ical": "^0.27.1",
    "vite": "^8.0.11",
    "vite-plugin-static-copy": "^4.1.0",
    "vituum": "^2.0.2"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21"
  }
}
