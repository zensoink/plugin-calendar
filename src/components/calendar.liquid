<section class="calendar-month-grid">
    <div class="month-header-days">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
    </div>

    <div class="month-cells">
        {% for day in calendar.days %}
            <div class="day-cell {% if day.is_today %}is-today{% endif %} {% if day.is_other_month %}other-month{% endif %}">
                <span class="day-number">{{ day.day_number }}</span>
                <div class="day-events">
                    {% for event in day.events %}
                        <div class="event-pill" style="background-color: {{ event.color | default: '#6b7280' }};">
                            <span class="event-time">{{ event.time_label }}</span>
                            <span class="event-title">{{ event.title }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>
