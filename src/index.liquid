<!DOCTYPE html>
<html lang="{{ zenso.user.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width={{ zenso.device.width }}, height={{ zenso.device.height }}, initial-scale=1.0">
    <link href="{{ 'favicon.ico' | asset_url }}" rel="icon" type="image/x-icon"/>
    <title>{{ plugin.name }}</title>
</head>
<body>
<main class="calendar-app">
    {% if data.calendar %}
        <div class="calendar-grid" id="calendar-grid"
            data-today="{{ data.calendar.today }}"
            data-now-label="{{ data.calendar.now_label }}"
            data-fetched-at="{{ data.calendar.fetched_at }}"
            data-view="{{ config.view }}"
            data-time-format="{{ config.time_format }}"
            data-locale="{{ zenso.user.locale }}"
            data-language="{{ zenso.user.language }}"></div>
        <template id="calendar-data">
            {% for e in data.calendar.events %}
            <span data-title="{{ e.title | escape }}" data-start="{{ e.start }}" data-end="{{ e.end }}" data-all-day="{{ e.all_day }}" data-color="{{ e.color }}"></span>
            {% endfor %}
        </template>
    {% else %}
        <div class="calendar-empty">
            <h1 class="calendar-date">No calendar configured</h1>
            <p>Add your ICS feed URLs in the plugin settings.</p>
        </div>
    {% endif %}
</main>
</body>
</html>
